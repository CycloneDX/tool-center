      "OSI_APPROVED"
    ],
    "functions": [
      "DISTRIBUTE"
    ],
    "packaging": [
      "APPLICATION",
      "CONTAINER_IMAGE"
    ],
    "library": [
      "GO"
    ],
    "platform": [
      "LINUX"
    ],
    "lifecycle": [
      "POST-BUILD",
      "OPERATIONS"
    ],
    "supportedStandards": [
      "CYCLONEDX"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.7",
      "CYCLONEDX_V1.6"
    ]
  }
