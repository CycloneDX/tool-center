      "MAC",
      "WINDOWS"
    ],
    "lifecycle": [
      "PRE-BUILD",
      "BUILD",
      "POST-BUILD"
    ],
    "supportedStandards": [
      "CYCLONEDX",
      "PACKAGE_URL",
      "SPDX"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.6",
      "CYCLONEDX_V1.7"
    ],
    "supportedLanguages": [
      "C/C++",
      "GO",
      "JAVA",
      "JAVASCRIPT/TYPESCRIPT",
      ".NET",
      "NODE.JS",
      "PHP",
      "PYTHON",
      "RUBY",
      "RUST"
    ]
  }
}
