      "SBOM",
      "VDR/VEX"
    ],
    "availability": [
      "FREEMIUM",
      "SUBSCRIPTION"
    ],
    "functions": [
      "ANALYSIS"
    ],
    "analysis": [
      "SECURITY_VULNERABILITIES",
      "OUTDATED_COMPONENTS"
    ],
    "transform": [],
    "packaging": [
      "APPLICATION"
    ],
    "library": [],
    "platform": [],
    "lifecycle": [
      "POST-BUILD",
      "OPERATIONS"
    ],
    "supportedStandards": [
      "CYCLONEDX",
      "SPDX",
      "CPE",
      "PACKAGE_URL"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.6"
    ],
    "supportedLanguages": [
      "C/C++"
    ]
  }
}
