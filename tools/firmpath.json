  "specVersion": "2.0",
  "tool": {
    "name": "Firmpath",
    "publisher": "Firmpath",
    "description": "Vulnerability monitoring for embedded firmware: resolves a build's SBOM and chip-vendor SDK (ESP-IDF, Zephyr, nRF Connect, STM32Cube, Silicon Labs) into bundled libraries and checks them against vendor advisories, NVD, OSV and KEV. Exports VEX.",
    "website_url": "https://www.firmpath.dev/",
