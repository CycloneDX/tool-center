{
  "$schema": "https://cyclonedx.org/schema/tool-center-v2.tool.schema.json",
  "specVersion": "2.0",
  "tool": {
    "name": "DevGuard",
    "publisher": "L3montree GmbH",
    "description": "Open-source vulnerability management platform (OWASP project, OpenSSF member). Its CLI builds CycloneDX SBOMs and signs artifacts; the server ingests SBOMs, ranks vulnerabilities by risk and serves live SBOM and VEX (CycloneDX, OpenVEX, CSAF).",
    "repository_url": "https://github.com/l3montree-dev/devguard",
    "website_url": "https://devguard.org",
    "capabilities": [
      "SBOM",
      "VDR/VEX"
    ],
    "availability": [
      "OPEN_SOURCE",
      "OSI_APPROVED",
      "SUBSCRIPTION"
    ],
    "functions": [
      "ANALYSIS",
      "DISTRIBUTE",
      "SIGNING/NOTARY"
    ],
    "analysis": [
      "SECURITY_VULNERABILITIES",
      "LICENSE_REPORTING",
      "POLICY_EVALUATION"
    ],
    "packaging": [
      "APPLICATION",
      "COMMAND_LINE_UTILITY",
      "CONTAINER_IMAGE",
      "GITHUB_ACTION",
      "GITLAB_CI_TEMPLATE"
    ],
    "library": [
      "GO"
    ],
    "platform": [
      "LINUX",
      "MAC",
      "WINDOWS"
    ],
    "lifecycle": [
      "PRE-BUILD",
      "BUILD",
      "POST-BUILD",
      "OPERATIONS"
    ],
    "supportedStandards": [
      "CYCLONEDX",
      "PACKAGE_URL",
      "SLSA"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.6"
    ],
    "supportedLanguages": [
      ".NET",
      "C/C++",
      "GO",
      "JAVA",
      "JAVASCRIPT/TYPESCRIPT",
      "NODE.JS",
      "PHP",
      "PYTHON",
      "RUBY",
      "RUST"
    ]
  }
}
