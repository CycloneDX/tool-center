      "APPLICATION"
    ],
    "lifecycle": [
      "DESIGN",
      "POST-BUILD",
      "OPERATIONS",
      "DISCOVERY"
    ],
    "supportedStandards": [
      "CYCLONEDX",
      "CPE",
      "PACKAGE_URL"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.7",
      "CYCLONEDX_V1.6",
      "CYCLONEDX_V1.5"
    ]
  }
