{
  "$schema": "https://cyclonedx.org/schema/tool-center-v2.tool.schema.json",
  "specVersion": "2.0",
  "tool": {
    "name": "licensegate",
    "publisher": "licensegate",
    "description": "Offline licence gate for npm dependencies: judges each licence by how you ship (SaaS, app, library, internal) and writes a CycloneDX 1.5 SBOM, an SPDX 2.3 SBOM and third-party notices. CLI for any CI and MCP server. Zero dependencies, MIT.",
    "website_url": "https://licensegate.org/",
    "capabilities": [
      "SBOM"
    ],
    "availability": [
      "OPEN_SOURCE",
      "OSI_APPROVED"
    ],
    "functions": [
      "AUTHOR",
      "ANALYSIS"
    ],
    "analysis": [
      "LICENSE_REPORTING",
      "POLICY_EVALUATION"
    ],
    "packaging": [
      "COMMAND_LINE_UTILITY"
    ],
    "platform": [
      "LINUX",
      "MAC",
      "WINDOWS"
    ],
    "lifecycle": [
      "BUILD",
      "POST-BUILD"
    ],
    "supportedStandards": [
      "CYCLONEDX",
      "SPDX",
      "PACKAGE_URL"
    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.5"
    ],
    "supportedLanguages": [
      "JAVASCRIPT/TYPESCRIPT",
      "NODE.JS"
    ]
  }
}
