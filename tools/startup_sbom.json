    "website_url": "https://morpheuslord.github.io/Startup-SBOM/",
    "capabilities": [
      "SBOM",
      "VDR/VEX"
    ],
    "availability": [
      "OPEN_SOURCE",
      "OSI_APPROVED"
    ],
    "functions": [
      "ANALYSIS"
    ],
    "analysis": [
