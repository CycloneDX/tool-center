    ],
    "cycloneDxVersion": [
      "CYCLONEDX_V1.7",
      "CYCLONEDX_V1.6",
      "CYCLONEDX_V1.5"
    ],
    "supportedLanguages": [
      "GO",
      "JAVA",
      "JAVASCRIPT/TYPESCRIPT",
      "NODE.JS",
